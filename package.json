{
  "name": "idek-shirts",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/copy-fonts.mjs",
    "dev": "npm run build && wrangler pages dev",
    "db:local": "wrangler d1 execute idek-shirts --local --file=schema.sql",
    "db:remote": "wrangler d1 execute idek-shirts --remote --file=schema.sql",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "jose": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@fontsource-variable/bricolage-grotesque": "^5.2.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0"
  }
}
