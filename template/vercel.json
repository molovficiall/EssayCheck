{
  "version": 2,
  "builds": [
    { "src": "templates/**", "use": "@vercel/static" },
    { "src": "styles/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/templates/index.html" },
    { "src": "/styles/(.*)", "dest": "/styles/$1" },
    { "src": "/(.*)", "dest": "/templates/$1" }
  ]
}